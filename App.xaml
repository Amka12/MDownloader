<Application x:Class="MDownloader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MDownloader.Converters">
    <Application.Resources>
        <converters:BoolToPlayPauseIconConverter x:Key="BoolToPlayPauseIconConverter" />
        <converters:BoolToVolumeIconConverter x:Key="BoolToVolumeIconConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Стили кнопок -->
        <Style TargetType="Button" x:Key="MediaButton">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="45" />
            <Setter Property="Height" Value="45" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#007ACC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#005A9E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для слайдера -->

        <!-- Пимпочка -->
        <ControlTemplate x:Key="SliderThumb" TargetType="Thumb">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Внешний круг -->
                <Ellipse x:Name="ThumbEllipse"
                         Width="16"
                         Height="16"
                         Fill="#007ACC"
                         Stroke="White"
                         StrokeThickness="2">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="4"
                                          ShadowDepth="0"
                                          Opacity="0.3" />
                    </Ellipse.Effect>
                </Ellipse>
                <!-- Внутренний круг -->
                <Ellipse Width="8"
                         Height="8"
                         Fill="White"
                         Opacity="0.5" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ThumbEllipse" Property="Fill" Value="#0099FF" />
                    <Setter TargetName="ThumbEllipse" Property="Width" Value="18" />
                    <Setter TargetName="ThumbEllipse" Property="Height" Value="18" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="ThumbEllipse" Property="Fill" Value="#005A9E" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Трек -->
        <Style TargetType="Slider" x:Key="VideoSeekBar">
            <Setter Property="Background" Value="#555555" />
            <Setter Property="Foreground" Value="#007ACC" />
            <Setter Property="IsMoveToPointEnabled" Value="False" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <!--Track-->
                            <Track x:Name="PART_Track" Cursor="Hand">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Foreground}"
                                                        CornerRadius="2"
                                                        Height="4" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Foreground}"
                                                        Opacity="0.3"
                                                        CornerRadius="2"
                                                        Height="6" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Template="{StaticResource SliderThumb}" />
                                </Track.Thumb>

                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Комбобокс с разрешениями -->
        <Style x:Key="CustomComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="30" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>

                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="3"
                                                BorderThickness="1"
                                                BorderBrush="#555" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#3D3D3D" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#3D3D3D" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsQualityListLoading}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#3D3D3D"
                                                                Duration="0:0:0.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#2D2D2D"
                                                                Duration="0:0:0.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    BorderThickness="1"
                                    BorderBrush="#555" IsHitTestVisible="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Выбранное значение -->
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      Margin="10,0,0,0"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False" />
                                    <!-- Стрелка справа -->
                                    <Path x:Name="Arrow"
                                          Grid.Column="1"
                                          Data="M0,0 L4,4 L8,0 Z"
                                          Fill="#AAA"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Выпадающий список -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#2D2D2D"
                                        BorderBrush="#555"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3D3D3D" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3D3D3D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
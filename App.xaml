<Application x:Class="MDownloader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MDownloader.Converters">

    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Button.xaml" />
                <ResourceDictionary Source="/Styles/ToggleButton.xaml" />
                <ResourceDictionary Source="/Styles/Slider.xaml" />
                <ResourceDictionary Source="/Styles/ComboBox.xaml" />
            </ResourceDictionary.MergedDictionaries>
       
        <converters:BoolToPlayPauseIconConverter x:Key="BoolToPlayPauseIconConverter" />
        <converters:BoolToVolumeIconConverter x:Key="BoolToVolumeIconConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        </ResourceDictionary>
    </Application.Resources>
</Application>